{#- 标准试卷 · HTML。PDF 导出也走这一份（Chromium 打印），所以样式必须同时
    照顾屏幕阅读与 A4 打印。

    单文件：样式内联、图片内联（data:）、公式用 MathML 由浏览器原生渲染。
    不引用任何外部资源——发给学生的那一份要能断网打开，Chromium 打印时也不必
    等任何网络请求。

    自定义模板可以继承这一套只改自己要改的部分：
        {% extends "standard/paper.html.j2" %}
        {% block extra_styles %}.paper-head h1 { color: #036; }{% endblock %}
-#}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ paper.title }}{% if paper.layout.value != "paper" %} · {{ paper.layout.label }}{% endif %}</title>
<style>
{% block styles %}
/* 纸是白的：这是文档不是应用，不跟随系统深色 */
:root { color-scheme: light; }

@page {
  size: {% block page_size %}A4{% endblock %};
  margin: {% block page_margin %}18mm 16mm{% endblock %};
}

body {
  margin: 0 auto;
  padding: 24px 20px 60px;
  max-width: 820px;
  background: #fff;
  color: #000;
  /* 衬线体是试卷的惯例；中文优先宋体，英文与公式用配套的衬线 */
  font-family: "Times New Roman", "SimSun", "Songti SC", "Noto Serif CJK SC", serif;
  font-size: {% block body_size %}11.5pt{% endblock %};
  line-height: 1.7;
}

/* ------------------------------------------------------------- 卷头 */
.paper-head { text-align: center; margin-bottom: 18px; }
.paper-head h1 {
  font-family: "SimHei", "Heiti SC", "Noto Sans CJK SC", sans-serif;
  font-size: {% block title_size %}17pt{% endblock %};
  margin: 0 0 8px;
  line-height: 1.4;
}
.paper-head .meta,
.paper-head .tally { font-size: 10.5pt; color: #333; }
.paper-head .meta span { margin: 0 8px; white-space: nowrap; }
.paper-head .tally { margin-top: 2px; }

.student-row {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  margin: 14px 0 6px;
  font-size: 11pt;
}
.student-row span { flex: 1; white-space: nowrap; }
.student-row u { display: inline-block; min-width: 5em; text-decoration: none;
                 border-bottom: 1px solid #000; }

.rule { border: none; border-top: 1.5px solid #000; margin: 10px 0 18px; }

.notice {
  border: 1px solid #a60;
  background: #fff8e8;
  padding: 6px 10px;
  font-size: 10.5pt;
  margin-bottom: 14px;
}

/* ------------------------------------------------------------- 大题 */
.section { margin-top: 20px; }
.section > h2 {
  font-family: "SimHei", "Heiti SC", "Noto Sans CJK SC", sans-serif;
  font-size: 12.5pt;
  margin: 0 0 6px;
  /* 大题标题不能孤零零留在页底 */
  break-after: avoid;
  page-break-after: avoid;
}
.section > .instructions { font-size: 10.5pt; color: #333; margin: 0 0 10px; }

/* ------------------------------------------------------------- 题目 */
.item {
  margin: 0 0 12px;
  /* 一道题尽量不跨页。超过一页高的题浏览器会忽略这条，属预期行为 */
  break-inside: avoid;
  page-break-inside: avoid;
}
.item > .stem { display: block; }
.item > .stem > .no { font-weight: bold; }
.item > .stem > .score { color: #333; }
/* 题干首段与题号同行，后续段落正常另起 */
.item .stem .body { display: inline; }
.item .stem .body > p:first-child { display: inline; }
.item .stem .body > p { margin: 0.5em 0; }

.options { margin: 2px 0 0; padding: 0; list-style: none; }
.options li { margin: 1px 0; }
.options .label { font-weight: 600; margin-right: 2px; }
.options p { display: inline; margin: 0; }

.sub { margin: 6px 0 0 1.6em; }
.sub > .lead { font-weight: 600; }
.sub p { margin: 0.3em 0; }

.program { margin: 4px 0 0 1.6em; font-size: 10.5pt; }
.program .case { margin: 2px 0; }

/* 答题区：给主观题留出空白，否则打印出来学生没地方写 */
.answer-space { border-bottom: 1px solid #bbb; height: 1.9em; margin-top: 4px; }

/* ----------------------------------------------------------- 答案区 */
.answer, .rubric, .explain {
  font-size: 10.5pt;
  margin: 4px 0 0 1.6em;
  padding-left: 8px;
  border-left: 3px solid #999;
}
.answer { border-left-color: #1d6b3f; }
.answer .tag, .rubric .tag, .explain .tag { font-weight: 600; }
.answer p, .rubric p, .explain p { display: inline; margin: 0; }

.key-run { margin: 0 0 12px; line-height: 2.1; }
.key-run .one { display: inline-block; margin-right: 1.4em; white-space: nowrap; }
.key-run .one b { font-weight: 600; }

/* ----------------------------------------------------------- 正文内容 */
.rendered img { max-width: 100%; height: auto; }
.rendered table { border-collapse: collapse; margin: 6px 0; }
.rendered th, .rendered td { border: 1px solid #000; padding: 3px 7px; }
.rendered pre {
  background: #f4f4f4;
  border: 1px solid #ddd;
  padding: 6px 9px;
  overflow-x: auto;
  font-size: 10pt;
  /* 打印时没有滚动条，长行必须折断，否则右边直接被裁掉 */
  white-space: pre-wrap;
  word-break: break-word;
}
.rendered code { font-family: "SF Mono", Consolas, "Liberation Mono", monospace; }
.rendered blockquote { margin: 6px 0 6px 1em; padding-left: 10px; border-left: 3px solid #ccc; }
.asset-missing { color: #a00; border: 1px dashed #a00; padding: 0 4px; }
math { font-size: 1.05em; }

@media print {
  body { padding: 0; max-width: none; font-size: {% block print_size %}11pt{% endblock %}; }
  .notice { display: none; }
}
{% endblock %}
{% block extra_styles %}{% endblock %}
</style>
</head>
<body>

{% block header %}
<header class="paper-head">
  <h1>{{ paper.title }}{% if paper.layout.value == "answers" %}　参考答案{% endif %}</h1>
  {% if paper.meta %}
  <div class="meta">
    {% for key, value in paper.meta.items() %}<span>{{ key }}：{{ value }}</span>{% endfor %}
  </div>
  {% endif %}
  <div class="tally">
    满分 {{ paper.total_score | g }} 分　共 {{ paper.question_count }} 题
    {% if paper.layout.value != "paper" %}　{{ paper.layout.label }}{% endif %}
  </div>
</header>

{% if paper.layout.value == "paper" %}
<div class="student-row">
  <span>班级 <u></u></span><span>姓名 <u></u></span><span>学号 <u></u></span><span>得分 <u></u></span>
</div>
{% endif %}
<hr class="rule">
{% endblock %}

{% if paper.missing_assets %}
<p class="notice">有 {{ paper.missing_assets }} 张图片未找到，正文中已用提示文字代替。</p>
{% endif %}

{% macro item_body(item) %}
<div class="stem rendered">
  <span class="no">{{ item.number }}．</span><span class="score">（{{ item.score | g }} 分）</span><span class="body">{{ item.stem | md }}</span>
</div>
{% if item.options %}
<ul class="options rendered">
  {% for option in item.options %}
  <li><span class="label">{{ option.label }}．</span>{{ option.content | md }}</li>
  {% endfor %}
</ul>
{% endif %}
{% if item.programming %}
<div class="program rendered">
  {% if item.programming.language %}<div>语言：{{ item.programming.language }}</div>{% endif %}
  {% if item.programming.function_signature %}
  <pre><code>{{ item.programming.function_signature }}</code></pre>
  {% endif %}
  {% if item.programming.starter_code %}
  <pre><code>{{ item.programming.starter_code }}</code></pre>
  {% endif %}
  {% for case in item.programming.test_cases %}
  <div class="case">样例{{ loop.index }}　输入：<code>{{ case.input }}</code>　输出：<code>{{ case.expected }}</code></div>
  {% endfor %}
</div>
{% endif %}
{% for sub in item.sub_questions %}
<div class="sub rendered">
  <span class="lead">{{ sub.label }}（{{ sub.score | g }} 分）</span>{{ sub.stem | md }}
  {% if paper.show_answers and sub.answer %}
  <div class="answer rendered"><span class="tag">答案：</span>{{ sub.answer | md }}</div>
  {% endif %}
  {% if paper.show_answers and sub.rubric %}
  <div class="rubric rendered"><span class="tag">评分：</span>{{ sub.rubric | md }}</div>
  {% endif %}
</div>
{% endfor %}
{% if paper.show_answers %}
{% if item.answer %}
<div class="answer rendered"><span class="tag">答案：</span>{{ item.answer | md }}</div>
{% endif %}
{% if item.explanation %}
<div class="explain rendered"><span class="tag">解析：</span>{{ item.explanation | md }}</div>
{% endif %}
{% if item.rubric %}
<div class="rubric rendered"><span class="tag">评分标准：</span>{{ item.rubric | md }}</div>
{% endif %}
{% endif %}
{% endmacro %}

{% block body %}
{% if paper.show_questions %}
{% for section in paper.sections %}
<section class="section">
  <h2>{{ section.title }}</h2>
  {% if section.instructions %}<p class="instructions">{{ section.instructions }}</p>{% endif %}
  {% for item in section.items %}
  <div class="item">{{ item_body(item) }}</div>
  {% endfor %}
</section>
{% endfor %}
{% endif %}
{% endblock %}

{% block answer_key %}
{% if paper.layout.value == "answers" %}
{% for section in paper.sections %}
<section class="section">
  <h2>{{ section.title }}</h2>
  {% if section.objective_items %}
  <p class="key-run">
    {% for item in section.objective_items %}
    <span class="one">{{ item.number }}．<b>{{ item.compact_answer }}</b></span>
    {% endfor %}
  </p>
  {% endif %}
  {% for item in section.subjective_items %}
  <div class="item">
    <div class="stem"><span class="no">{{ item.number }}．</span><span class="score">（{{ item.score | g }} 分）</span></div>
    {% if item.answer %}<div class="answer rendered">{{ item.answer | md }}</div>{% endif %}
    {% for sub in item.sub_questions %}
    <div class="sub rendered">
      <span class="lead">{{ sub.label }}（{{ sub.score | g }} 分）</span>{{ sub.answer | md }}
      {% if sub.rubric %}<div class="rubric rendered"><span class="tag">评分：</span>{{ sub.rubric | md }}</div>{% endif %}
    </div>
    {% endfor %}
    {% if item.rubric %}
    <div class="rubric rendered"><span class="tag">评分标准：</span>{{ item.rubric | md }}</div>
    {% endif %}
  </div>
  {% endfor %}
</section>
{% endfor %}
{% endif %}
{% endblock %}

</body>
</html>
